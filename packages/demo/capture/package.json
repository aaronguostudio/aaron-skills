{
  "name": "demo-capture",
  "version": "0.1.0",
  "private": true,
  "description": "Record scripted walkthroughs of any web app into a capture folder (contract 1) for the walkthrough renderer.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs test/*.e2e.mjs",
    "test:unit": "node --test test/*.test.mjs",
    "test:e2e": "node --test test/*.e2e.mjs",
    "mutation-check": "node test/mutation-check.mjs"
  },
  "dependencies": {
    "playwright": "1.62.1"
  }
}
